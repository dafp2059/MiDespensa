Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS y quitar "www"
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Direcciones antiguas de WordPress
  RewriteRule ^listings/?$ /inmuebles [L,R=301]
  RewriteRule ^listing/([^/]+)/?$ /inmueble/$1 [L,R=301]
  RewriteRule ^portal-de-pagos/?$ /pagos [L,R=301]
  RewriteRule ^contactenos/?$ /contacto [L,R=301]
  RewriteRule ^sobre-nosotros/?$ /nosotros [L,R=301]
  RewriteRule ^blog/?$ /proyectos [L,R=301]

  # URLs amigables
  RewriteRule ^inmueble/([a-z0-9-]+)/?$ inmueble.php?slug=$1 [L,QSA]
  RewriteRule ^proyecto/([a-z0-9-]+)/?$ proyecto.php?slug=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # /contacto -> contacto.php
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.php [L,QSA]

  # Páginas creadas en el panel: /nosotros, /propietarios…
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/?$ pagina.php?slug=$1 [L,QSA]
</IfModule>

# Caché del navegador para imágenes, estilos y scripts
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
